generator client { provider="prisma-client-js" }
datasource db { provider="postgresql" url=env("DATABASE_URL") }
model User { id String @id @default(cuid()); email String @unique; passwordHash String?; name String?; role String @default("user"); emailVerified DateTime?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; profile Profile?; websites Website[]; notifications Notification[]; media Media[]; comments Guestbook[] }
model Profile { id String @id @default(cuid()); userId String @unique; user User @relation(fields:[userId],references:[id],onDelete:Cascade); avatarUrl String?; phone String?; bio String?; settings Json?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Website { id String @id @default(cuid()); userId String; user User @relation(fields:[userId],references:[id],onDelete:Cascade); slug String @unique; title String; status String @default("draft"); templateId String @default("master"); content Json; views Int @default(0); passwordHash String?; seo Json?; faviconUrl String?; shareImageUrl String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; analytics AnalyticsEvent[]; gallery Gallery[]; music Music[]; videos Video[]; timeline Timeline[]; memories Memory[]; wishlist WishlistItem[]; guestbook Guestbook[] }
model Template { id String @id @default(cuid()); slug String @unique; name String; category String; description String?; previewUrl String?; active Boolean @default(true); config Json; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Gallery { id String @id @default(cuid()); websiteId String; website Website @relation(fields:[websiteId],references:[id],onDelete:Cascade); url String; caption String?; sort Int @default(0); createdAt DateTime @default(now()) }
model Music { id String @id @default(cuid()); websiteId String; website Website @relation(fields:[websiteId],references:[id],onDelete:Cascade); url String; title String?; createdAt DateTime @default(now()) }
model Video { id String @id @default(cuid()); websiteId String; website Website @relation(fields:[websiteId],references:[id],onDelete:Cascade); url String; title String?; createdAt DateTime @default(now()) }
model Timeline { id String @id @default(cuid()); websiteId String; website Website @relation(fields:[websiteId],references:[id],onDelete:Cascade); date String; title String; description String; sort Int @default(0) }
model Memory { id String @id @default(cuid()); websiteId String; website Website @relation(fields:[websiteId],references:[id],onDelete:Cascade); text String; sort Int @default(0) }
model WishlistItem { id String @id @default(cuid()); websiteId String; website Website @relation(fields:[websiteId],references:[id],onDelete:Cascade); title String; url String?; claimed Boolean @default(false) }
model Guestbook { id String @id @default(cuid()); websiteId String; website Website @relation(fields:[websiteId],references:[id],onDelete:Cascade); userId String?; user User? @relation(fields:[userId],references:[id],onDelete:SetNull); name String; message String; approved Boolean @default(false); createdAt DateTime @default(now()) }
model AnalyticsEvent { id String @id @default(cuid()); websiteId String; website Website @relation(fields:[websiteId],references:[id],onDelete:Cascade); type String; country String?; device String?; browser String?; referrer String?; path String?; createdAt DateTime @default(now()) }
model Media { id String @id @default(cuid()); userId String; user User @relation(fields:[userId],references:[id],onDelete:Cascade); url String; publicId String?; type String; folder String?; createdAt DateTime @default(now()) }
model Notification { id String @id @default(cuid()); userId String; user User @relation(fields:[userId],references:[id],onDelete:Cascade); title String; message String; read Boolean @default(false); createdAt DateTime @default(now()) }
model EmailTemplate { id String @id @default(cuid()); key String @unique; subject String; body String; updatedAt DateTime @updatedAt }
model Setting { key String @id; value Json; updatedAt DateTime @updatedAt }
model DemoSite { id String @id @default(cuid()); slug String @unique; title String; content Json; active Boolean @default(true); updatedAt DateTime @updatedAt }

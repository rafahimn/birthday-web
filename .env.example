# Birthday Builder SaaS - Supabase ONLY
NEXT_PUBLIC_APP_URL="https://YOUR-DOMAIN.vercel.app"

# Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
# Server-only. NEVER expose this in NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Optional direct Gmail SMTP for application/admin mail.
# Supabase Auth emails should be configured with the same Gmail SMTP
# in Supabase Dashboard > Authentication > SMTP Settings.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="yourgmail@gmail.com"
SMTP_APP_PASSWORD="16-character-google-app-password"
EMAIL_FROM="Birthday Builder <yourgmail@gmail.com>"
ADMIN_EMAIL="admin@example.com"

# Google OAuth is configured INSIDE Supabase:
# Authentication > Providers > Google.
# Do not put Google client credentials in this .env unless you add a separate direct Google OAuth implementation.

# Google Photos Picker (optional)
GOOGLE_PHOTOS_CLIENT_ID=
GOOGLE_PHOTOS_CLIENT_SECRET=
GOOGLE_PHOTOS_REDIRECT_URI=

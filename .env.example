# Postgres connection string — get this from Supabase or Neon.
# Supabase: Project Settings > Database > Connection string (URI, "Transaction" pooler works well for serverless)
# Neon: dashboard > Connection Details
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="change-this-to-a-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Base URL used to build shareable links, e.g. https://yourdomain.com
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Cloudinary — used for the "Upload" buttons in the editor (photos, videos,
# audio). Create a free account at cloudinary.com, then:
# 1. NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME = your "Cloud name" (dashboard home page)
# 2. Settings > Upload > Upload presets > Add upload preset > Signing Mode: "Unsigned" > save, then paste its name below
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your-unsigned-preset"
